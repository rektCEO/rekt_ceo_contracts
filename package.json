{
  "name": "rekt-ceo-smart-contracts",
  "version": "1.0.0",
  "description": "Smart contracts for Rekt CEO PFP and Meme NFT minting platform",
  "main": "index.js",
  "scripts": {
    "compile": "hardhat compile",
    "test": "hardhat test",
    "deploy": "hardhat run scripts/deploy.js",
    "deploy:bsc": "hardhat run scripts/deploy.js --network bsc",
    "deploy:bsc-testnet": "hardhat run scripts/deploy.js --network bscTestnet",
    "deploy:ethereum": "hardhat run scripts/deploy.js --network ethereum",
    "deploy:sepolia": "hardhat run scripts/deploy.js --network sepolia",
    "deploy:polygon": "hardhat run scripts/deploy.js --network polygon",
    "deploy:mumbai": "hardhat run scripts/deploy.js --network mumbai",
    "deploy:enhanced": "hardhat run scripts/enhanced-deploy.js",
    "deploy:enhanced:bsc": "hardhat run scripts/enhanced-deploy.js --network bsc",
    "deploy:enhanced:bsc-testnet": "hardhat run scripts/enhanced-deploy.js --network bscTestnet",
    "deploy:enhanced:localhost": "hardhat run scripts/enhanced-deploy.js --network localhost",
    "test:enhanced": "hardhat run scripts/enhanced-test.js",
    "test:enhanced:localhost": "hardhat run scripts/enhanced-test.js --network localhost",
    "test:enhanced:bsc-testnet": "hardhat run scripts/enhanced-test.js --network bscTestnet",
    "test:recovery": "hardhat test test/EnhancedRecovery.test.js",
    "test:comprehensive": "hardhat run scripts/comprehensive-test.js",
    "test:all": "npm run test:recovery && npm run test:comprehensive",
    "setup:local": "./scripts/setup-local.sh",
    "verify": "hardhat verify",
    "coverage": "hardhat coverage",
    "gas-report": "REPORT_GAS=true hardhat test",
    "node": "hardhat node",
    "clean": "hardhat clean"
  },
  "keywords": [
    "nft",
    "erc721",
    "erc20",
    "defi",
    "rekt-ceo",
    "smart-contracts",
    "solidity"
  ],
  "author": "Rekt CEO Team",
  "license": "MIT",
  "devDependencies": {
    "@nomicfoundation/hardhat-chai-matchers": "^2.0.0",
    "@nomicfoundation/hardhat-ethers": "^3.0.0",
    "@nomicfoundation/hardhat-network-helpers": "^1.0.0",
    "@nomicfoundation/hardhat-toolbox": "^3.0.0",
    "@nomicfoundation/hardhat-verify": "^1.0.0",
    "@typechain/ethers-v6": "^0.4.0",
    "@typechain/hardhat": "^8.0.0",
    "@types/chai": "^4.2.0",
    "@types/mocha": ">=9.1.0",
    "@types/node": ">=16.0.0",
    "chai": "^4.2.0",
    "ethers": "^6.4.0",
    "hardhat": "^2.17.0",
    "hardhat-gas-reporter": "^1.0.8",
    "solidity-coverage": "^0.8.1",
    "ts-node": ">=8.0.0",
    "typechain": "^8.3.0",
    "typescript": ">=4.5.0"
  },
  "dependencies": {
    "@openzeppelin/contracts": "^4.9.3",
    "dotenv": "^16.3.1"
  }
}
