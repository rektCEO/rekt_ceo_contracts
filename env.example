# Environment Variables for Rekt CEO Smart Contracts
# Copy this file to .env and fill in your values

# Private key for deployment (without 0x prefix)
PRIVATE_KEY=your_private_key_here

# RPC URLs (optional - defaults are provided in hardhat.config.js)
ETHEREUM_RPC_URL=https://eth.llamarpc.com
SEPOLIA_RPC_URL=https://rpc.sepolia.org
BASE_RPC_URL=https://mainnet.base.org
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org

# API Keys for contract verification
BSCSCAN_API_KEY=your_bscscan_api_key_here
BASESCAN_API_KEY=your_basescan_api_key_here
ETHERSCAN_API_KEY=your_etherscan_api_key_here
POLYGONSCAN_API_KEY=your_polygonscan_api_key_here

# Gas reporting
REPORT_GAS=true

# Deployment Configuration (update these in deploy.js)
# ADMIN_ADDRESS=0x... (multisig recommended)
# TREASURY_ADDRESS=0x...
# DEV_WALLET_ADDRESS=0x...
# APPROVER_ADDRESS=0x... (backend wallet)
# RESCUER_ADDRESS=0x...

# Testing Configuration (for test-swap.js script)
CEO_TOKEN_ADDRESS=0x... # Your deployed CEO token address
UNISWAP_TESTER_BASE=0x... # Your deployed UniswapSwapTester contract address on Base
TEST_AMOUNT=100 # Amount of CEO tokens to test swap with (default: 100)
EXECUTE_SWAP=false # Set to 'true' to execute real swap (default: false for dry run)
