# Rekt CEO Contracts Deployment Configuration
# Copy this file to your root .env and fill in your values

# ===== Existing Contract Addresses (Optional) =====
# If you have already deployed contracts, provide their addresses here
# Leave empty to deploy new contracts

# CEO Token address (leave empty to deploy new)
CEO_TOKEN_ADDRESS=

# PFP Collection address (leave empty to deploy new)
PFP_COLLECTION_ADDRESS=

# Meme Collection address (leave empty to deploy new)
MEME_COLLECTION_ADDRESS=

# Minter Contract address (leave empty to deploy new)
MINTER_CONTRACT_ADDRESS=

# USDC Token address
# For Sepolia testnet: 0x1c7D4B196Cb0C7B01d743Fbc6116a902379C7238
# For Mainnet: Use actual USDC address
# Leave empty to deploy mock USDC for testing
USDC_ADDRESS=

# ===== Admin Addresses (Optional) =====
# These addresses will have special permissions
# Leave empty to use deployer address

# Main admin address (recommended: use multisig)
ADMIN_ADDRESS=

# Treasury address for receiving fees
TREASURY_ADDRESS=

# Safe wallet address for royalties (recommended: Gnosis Safe)
SAFE_WALLET_ADDRESS=

# Backend approver address (for minting approvals)
APPROVER_ADDRESS=

# Rescuer address (for emergency withdrawals)
RESCUER_ADDRESS=

# ===== Block Explorer API Keys (Required for Step 8 - Contract Verification) =====
# Get API keys from:
# - Etherscan: https://etherscan.io/myapikey
# - Basescan: https://basescan.org/myapikey
# - BscScan: https://bscscan.com/myapikey
# - PolygonScan: https://polygonscan.com/myapikey

# Etherscan API Key (for Ethereum Mainnet and Sepolia Testnet)
ETHERSCAN_API_KEY=

# Basescan API Key (for Base Mainnet and Base Sepolia Testnet)
BASESCAN_API_KEY=

# BscScan API Key (for BNB Smart Chain Mainnet and Testnet)
BSCSCAN_API_KEY=

# PolygonScan API Key (for Polygon Mainnet and Mumbai Testnet)
POLYGONSCAN_API_KEY=

# ===== Usage =====
# 1. Copy values to your root .env file
# 2. Run all steps: npx hardhat run scripts/deploy/deploy_all.js --network <network>
# 3. Or run individual steps: npx hardhat run scripts/deploy/1_deploy_ceo_token.js --network <network>
# 4. To verify contracts on explorer: npx hardhat run scripts/deploy/8_verify_explorer.js --network <network>

